<Project>
  <PropertyGroup>
    <!-- Single place to move the whole solution to a new .NET. .NET 10 is the current LTS. -->
    <ZeroTargetFramework>net10.0</ZeroTargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Version>0.9.0</Version>
    <Authors>Arjun Nair</Authors>
    <Product>Zero</Product>
    <Copyright>Copyright © 2009-2026 Arjun Nair</Copyright>
    <!-- Legacy code base: silence noise that predates the port. Tighten later. -->
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0162;CS0168;CS0169;CS0219;CS0414;CS0618;CS0649;CS0652;CS0659;CS0661;CS1717;CS8981;SYSLIB0011;SYSLIB0014</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
