<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Zero.App.Controls"
        x:Class="Zero.App.MainWindow"
        Title="Zero X"
        Icon="/Assets/zero.ico"
        Width="760" Height="672"
        MinWidth="400" MinHeight="240"
        WindowStartupLocation="CenterScreen">
  <!-- The menu tree is a NativeMenu built in MainWindow.Menu.cs: macOS exports it to the system
       menu bar; elsewhere NativeMenuBar draws it here. One tree, one source of check-mark truth. -->
  <DockPanel>
    <NativeMenuBar DockPanel.Dock="Top" x:Name="MenuBar" />

    <!-- Only shown while the deck is not: the deck's display carries the same information. -->
    <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="#18000000" Padding="8,3">
      <DockPanel>
        <TextBlock x:Name="StatusTape" DockPanel.Dock="Right" Opacity="0.7" Margin="12,0,0,0" />
        <TextBlock x:Name="StatusFps" DockPanel.Dock="Right" Opacity="0.7" Margin="12,0,0,0" />
        <TextBlock x:Name="StatusMachine" FontWeight="SemiBold" />
        <TextBlock x:Name="StatusMessage" Opacity="0.85" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- The hi-fi decks sit on a shelf under the screen, scaled to the window's width up to a
         limit (see DeckHeightFor in MainWindow.Deck.cs). -->
    <Border x:Name="DeckShelf" DockPanel.Dock="Bottom" Padding="8,6,8,7" BorderBrush="#2C2D31" BorderThickness="0,1,0,0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#1A1B1E" Offset="0" />
          <GradientStop Color="#0C0C0E" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <Viewbox x:Name="DeckViewbox" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center">
        <c:DeckPanel x:Name="Deck" />
      </Viewbox>
    </Border>

    <!-- CRT effects live in the display's own shader; see Controls/CrtShader.cs. -->
    <c:SpectrumDisplay x:Name="Display" />
  </DockPanel>
</Window>
