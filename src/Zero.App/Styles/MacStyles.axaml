<!-- macOS-only look: applied from App.axaml.cs when running on macOS. Avalonia draws its own controls,
     so this cannot make them native; it makes them follow Mac conventions: system font at 13 pt,
     compact rounded controls, small check boxes and radios, segmented-control style tabs. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="ContentControlThemeFontFamily">$Default</FontFamily>
      <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
      <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
      <!-- Fluent draws a selection underline under tab headers; the segmented look has none. -->
      <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="Transparent" />
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="MacSegmentSelectedBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MacSegmentSelectedBorderBrush" Color="#BFBFBF" />
          <SolidColorBrush x:Key="MacSegmentTrackBrush" Color="#DCDCDC" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="MacSegmentSelectedBrush" Color="#6A6A6A" />
          <SolidColorBrush x:Key="MacSegmentSelectedBorderBrush" Color="#808080" />
          <SolidColorBrush x:Key="MacSegmentTrackBrush" Color="#33FFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="$Default" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Buttons: push-button height and rounding -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="14,2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Fields -->
  <Style Selector="TextBox, ComboBox, NumericUpDown">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Padding" Value="8,0,0,0" />
  </Style>

  <!-- Check boxes and radios: 16 px, tight rounding -->
  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="22" />
  </Style>
  <Style Selector="CheckBox /template/ Border#NormalRectangle">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="CornerRadius" Value="3.5" />
  </Style>
  <Style Selector="RadioButton">
    <Setter Property="MinHeight" Value="22" />
  </Style>
  <Style Selector="RadioButton /template/ Ellipse#OuterEllipse, RadioButton /template/ Ellipse#CheckOuterEllipse">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>
  <Style Selector="RadioButton /template/ Ellipse#CheckGlyph">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
  </Style>

  <!-- Tabs as a centred segmented control -->
  <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,2,0,10" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource MacSegmentTrackBrush}" />
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Background" Value="{DynamicResource MacSegmentSelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MacSegmentSelectedBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="TabItem /template/ Border#PART_LayoutRoot">
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <!-- Lists -->
  <Style Selector="ListBox">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="8,2" />
  </Style>
</Styles>
