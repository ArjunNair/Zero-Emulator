<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Zero.App.Windows.GamepadWindow"
        Title="Gamepad Buttons"
        Icon="/Assets/zero.ico"
        SizeToContent="Width"
        Height="600" MinWidth="480" MaxWidth="900"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Text="Gamepad" VerticalAlignment="Center" />
      <ComboBox x:Name="PadSelector" Width="90" SelectionChanged="OnPadChanged" />
      <TextBlock x:Name="PadName" Foreground="#BBBBBB" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Foreground="#BBBBBB" TextWrapping="Wrap" Margin="0,0,0,8"
               Text="Press a button on the pad to highlight its row. Sticks and D-pad always steer; assign fires or any Spectrum key to buttons." />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button x:Name="DefaultsButton" Content="Defaults" MinWidth="90" Click="OnDefaults" />
      <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" IsCancel="True" Click="OnCancel" />
      <Button x:Name="OkButton" Classes="accent" Content="OK" MinWidth="90" IsDefault="True" Click="OnOk" />
    </StackPanel>
    <ScrollViewer>
      <Grid x:Name="Rows" ColumnDefinitions="200,*" />
    </ScrollViewer>
  </DockPanel>
</Window>
