<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tape="using:Zero.Emulation.Tape"
        x:Class="Zero.App.Windows.TapeDeckWindow"
        Title="Tape Deck"
        Icon="/Assets/zero.ico"
        Width="520" Height="420"
        MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,2" />
    <TextBlock DockPanel.Dock="Top" x:Name="InfoText" Foreground="#BBBBBB" TextWrapping="Wrap" Margin="0,0,0,8" />
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
      <Button x:Name="InsertButton" Content="Insert…" Click="OnInsert" />
      <Button x:Name="EjectButton" Content="Eject" Click="OnEject" />
      <Border Width="12" />
      <Button x:Name="RewindButton" Content="⏮ Rewind" Click="OnRewind" />
      <Button x:Name="PrevButton" Content="◀ Prev" Click="OnPrev" />
      <Button x:Name="PlayButton" Content="▶ Play" Click="OnPlay" />
      <Button x:Name="StopButton" Content="■ Stop" Click="OnStop" />
      <Button x:Name="NextButton" Content="Next ▶" Click="OnNext" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="14" Margin="0,0,0,8">
      <CheckBox x:Name="AutoLoadBox" Content="Auto load" Click="OnOptionChanged" />
      <CheckBox x:Name="AutoPlayBox" Content="Auto play/stop" Click="OnOptionChanged" />
      <CheckBox x:Name="EdgeLoadBox" Content="Edge loading" Click="OnOptionChanged" />
      <CheckBox x:Name="FastLoadBox" Content="Fast loading" Click="OnOptionChanged" />
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Background="#1E1E1E" Padding="8,4" Margin="0,8,0,0" CornerRadius="3">
      <TextBlock x:Name="StatusText" Foreground="#DDDDDD" />
    </Border>
    <ListBox x:Name="BlockList" SelectionMode="Single" DoubleTapped="OnBlockDoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="tape:TapeBlockInfo">
          <Grid ColumnDefinitions="36,110,*">
            <TextBlock Grid.Column="0" Text="{Binding Index}" Foreground="#888888" />
            <TextBlock Grid.Column="1" Text="{Binding Block}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="{Binding Info}" TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
