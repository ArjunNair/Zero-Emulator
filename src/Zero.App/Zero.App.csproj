<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cross-platform desktop shell (Avalonia). Windows, macOS (x64/arm64), Linux. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(ZeroTargetFramework)</TargetFramework>
    <RootNamespace>Zero.App</RootNamespace>
    <AssemblyName>Zero</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets/zero.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Zero is English-only, so invariant globalization keeps the published output small. Themes may
         still construct a CultureInfo for their own localisation (Semi builds one for zh-CN), which
         throws in invariant mode unless arbitrary culture names are allowed to resolve to invariant data. -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <!-- Selectable UI themes (Options > Appearance). Classic has no stable Avalonia 12 build yet. -->
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.2" />
    <PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
    <PackageReference Include="Classic.Avalonia.Theme" Version="12.0.1-beta1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Speccy\Speccy.csproj" />
    <ProjectReference Include="..\Peripherals\Peripherals.csproj" />
    <ProjectReference Include="..\Zero.Emulation\Zero.Emulation.csproj" />
    <ProjectReference Include="..\Zero.Sdl\Zero.Sdl.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Bundled machine ROMs and sample programs travel with the executable. -->
    <None Include="..\..\run\roms\*.rom" Link="roms\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\run\programs\**\*" Link="programs\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Zero.App.Tests" />
  </ItemGroup>
</Project>
