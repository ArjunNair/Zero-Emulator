<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Zero.App.Controls"
             x:Class="Zero.App.Controls.DeckPanel"
             Focusable="False">
  <!-- The hi-fi deck under the screen. Its look is the hardware's, not the UI theme's: every key
       and legend is styled here so Semi, Simple and Pipboy all show the same black faceplate. -->
  <UserControl.Resources>
    <SolidColorBrush x:Key="DeckLegend" Color="#9A9DA3" />
    <SolidColorBrush x:Key="DeckGlyph" Color="#D8DADE" />
    <!-- The faceplate's lettering. Set by style, not inherited, because themes (Pipboy) style every
         TextBlock with their own font and a style beats an inherited value. -->
    <FontFamily x:Key="DeckFont">avares://Zero/Assets/Fonts#Barlow Semi Condensed, fonts:Inter#Inter, $Default</FontFamily>

    <LinearGradientBrush x:Key="KeyFace" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#45474C" Offset="0" />
      <GradientStop Color="#2B2C30" Offset="0.5" />
      <GradientStop Color="#1C1D20" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KeyFaceHover" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#52555B" Offset="0" />
      <GradientStop Color="#34363A" Offset="0.5" />
      <GradientStop Color="#222326" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KeyFacePressed" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#1A1B1D" Offset="0" />
      <GradientStop Color="#26272A" Offset="1" />
    </LinearGradientBrush>

    <!-- The same, in satin aluminium, for the silver finish. -->
    <LinearGradientBrush x:Key="SilverKeyFace" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#F3F4F6" Offset="0" />
      <GradientStop Color="#CDD0D4" Offset="0.5" />
      <GradientStop Color="#A9ADB3" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SilverKeyFaceHover" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#FAFBFC" Offset="0" />
      <GradientStop Color="#D9DCE0" Offset="0.5" />
      <GradientStop Color="#B6BABF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SilverKeyFacePressed" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#A3A7AD" Offset="0" />
      <GradientStop Color="#C3C6CB" Offset="1" />
    </LinearGradientBrush>

    <!-- A transport key: a rectangular black key that sinks a pixel when pressed. -->
    <ControlTheme x:Key="DeckKey" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource DeckGlyph}" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border CornerRadius="2.5" Background="#000000" Margin="0,1.5,0,-1.5" />
            <Border Name="PART_Body" CornerRadius="2.5" BorderBrush="#050506" BorderThickness="0.8"
                    Background="{StaticResource KeyFace}">
              <Border CornerRadius="2" BorderThickness="0,1,0,0" BorderBrush="#38FFFFFF">
                <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Border>
          </Panel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#PART_Body">
        <Setter Property="Background" Value="{StaticResource KeyFaceHover}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_Body">
        <Setter Property="Background" Value="{StaticResource KeyFacePressed}" />
        <Setter Property="RenderTransform" Value="translate(0px, 1px)" />
      </Style>
      <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.35" />
      </Style>
    </ControlTheme>

    <!-- A small round push button set in a shallow ring in the faceplate, for an action that
         should not be hit by accident (reset). -->
    <ControlTheme x:Key="DeckRecessedKey" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <!-- A shallow recess round it: a fine edge in shadow at the top, catching the light at
                 the bottom. Even sizes keep the button dead centre in it. -->
            <Border CornerRadius="8" BorderThickness="0.8">
              <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Color="#A0000000" Offset="0" />
                  <GradientStop Color="#30FFFFFF" Offset="1" />
                </LinearGradientBrush>
              </Border.BorderBrush>
            </Border>
            <Border Name="PART_Body" Width="14" Height="14" CornerRadius="7" BorderBrush="#050506" BorderThickness="0.8"
                    Background="{StaticResource KeyFace}">
              <Border CornerRadius="6.5" BorderThickness="0,1,0,0" BorderBrush="#38FFFFFF" />
            </Border>
          </Panel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#PART_Body">
        <Setter Property="Background" Value="{StaticResource KeyFaceHover}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_Body">
        <Setter Property="Background" Value="{StaticResource KeyFacePressed}" />
        <Setter Property="RenderTransform" Value="scale(0.92)" />
      </Style>
    </ControlTheme>

    <!-- A latching function key with a lamp strip that glows amber while it is on. -->
    <ControlTheme x:Key="DeckToggle" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource DeckGlyph}" />
      <Setter Property="FontSize" Value="7" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border CornerRadius="2.5" Background="#000000" Margin="0,1.5,0,-1.5" />
            <Border Name="PART_Body" CornerRadius="2.5" BorderBrush="#050506" BorderThickness="0.8"
                    Background="{StaticResource KeyFace}">
              <Border CornerRadius="2" BorderThickness="0,1,0,0" BorderBrush="#38FFFFFF">
                <DockPanel>
                  <Border Name="PART_Lamp" DockPanel.Dock="Top" Height="2" Margin="7,2.5,7,0"
                          CornerRadius="1" Background="#3A2A10" />
                  <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
            </Border>
          </Panel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#PART_Body">
        <Setter Property="Background" Value="{StaticResource KeyFaceHover}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_Body">
        <Setter Property="Background" Value="{StaticResource KeyFacePressed}" />
        <Setter Property="RenderTransform" Value="translate(0px, 1px)" />
      </Style>
      <Style Selector="^:checked /template/ Border#PART_Lamp">
        <Setter Property="Background" Value="#FFB040" />
        <Setter Property="BoxShadow" Value="0 0 4 1 #A0FF9A20" />
      </Style>
    </ControlTheme>

    <!-- A latching key that stays down while it is on, its lamp lit (pause). -->
    <ControlTheme x:Key="DeckLatchKey" TargetType="ToggleButton" BasedOn="{StaticResource DeckToggle}">
      <Style Selector="^:checked /template/ Border#PART_Body">
        <Setter Property="Background" Value="{StaticResource KeyFacePressed}" />
        <Setter Property="RenderTransform" Value="translate(0px, 1px)" />
      </Style>
    </ControlTheme>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource DeckFont}" />
    </Style>
    <Style Selector="c|DeckKnob, c|DeckSlideSwitch">
      <Setter Property="TextElement.FontFamily" Value="{StaticResource DeckFont}" />
    </Style>

    <!-- The badge: steel letters with a dark edge below, where they stand off the plate. -->
    <Style Selector="Canvas.badge">
      <Setter Property="Effect">
        <DropShadowEffect OffsetX="0" OffsetY="0.8" BlurRadius="0.8" Color="#000000" Opacity="0.9" />
      </Setter>
    </Style>
    <Style Selector="Canvas.badge Path">
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Square" />
      <Setter Property="Stroke">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#F6F7F9" Offset="0" />
          <GradientStop Color="#C3C7CC" Offset="0.42" />
          <GradientStop Color="#8C9097" Offset="0.5" />
          <GradientStop Color="#D9DCE0" Offset="0.62" />
          <GradientStop Color="#9A9EA5" Offset="1" />
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="TextBlock.version">
      <Setter Property="Foreground" Value="#8A8D93" />
    </Style>

    <!-- Printed legends on the faceplate. -->
    <Style Selector="TextBlock.legend">
      <Setter Property="Foreground" Value="{StaticResource DeckLegend}" />
      <Setter Property="FontSize" Value="7.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.2" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <!-- The slide switches' end stops sit the same way in, so their slots line up. -->
    <Style Selector="c|DeckSlideSwitch">
      <Setter Property="Inset" Value="9" />
    </Style>
    <!-- Printed lines joining controls that work together. -->
    <Style Selector="Border.bracket">
      <Setter Property="BorderBrush" Value="#6A6D73" />
    </Style>
    <!-- The disk's name inside a drive bay: muted, and fainter still for an empty drive. -->
    <Style Selector="TextBlock.bayname">
      <Setter Property="Foreground" Value="#7C7F85" />
      <Setter Property="FontSize" Value="7.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.3" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.bayname.empty">
      <Setter Property="Foreground" Value="#4E5157" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="Foreground" Value="#6F7278" />
      <Setter Property="FontSize" Value="7.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.4" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Path.glyph">
      <Setter Property="Fill" Value="{StaticResource DeckGlyph}" />
    </Style>
    <!-- Line-drawn glyphs, such as the reset arrow. -->
    <Style Selector="Path.glyphline">
      <Setter Property="Stroke" Value="{StaticResource DeckGlyph}" />
      <Setter Property="StrokeThickness" Value="1.2" />
      <Setter Property="StrokeLineCap" Value="Round" />
    </Style>
    <!-- Engraved divider between sections. -->
    <Style Selector="Border.divider">
      <Setter Property="Width" Value="2" />
      <Setter Property="Margin" Value="11,4" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="BorderBrush" Value="#14FFFFFF" />
      <Setter Property="Background" Value="#0A0A0B" />
    </Style>
    <!-- VFD text, in the muted phosphor colours of an old display: cyan by default, with a soft bloom.
         Unlit segments stay faintly visible. -->
    <Style Selector="c|VfdText.vfd">
      <Setter Property="Foreground" Value="#66D4CF" />
      <Setter Property="Effect">
        <DropShadowEffect Color="#66D4CF" BlurRadius="4" OffsetX="0" OffsetY="0" Opacity="0.5" />
      </Setter>
    </Style>
    <!-- A square display segment: a drive's busy light, red like the drive bays' own lights. -->
    <Style Selector="Border.vfdled">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="Margin" Value="0,0,5,0" />
      <Setter Property="CornerRadius" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="#3A1816" />
    </Style>
    <Style Selector="Border.vfdled.lit">
      <Setter Property="Background" Value="#E0645C" />
      <Setter Property="BoxShadow" Value="0 0 3 1 #70E0645C" />
    </Style>
    <!-- Part lit: a +3 drive's light at rest, its select line pulsed by the controller's polling. -->
    <Style Selector="Border.vfdled.dim">
      <Setter Property="Background" Value="#80352F" />
    </Style>
    <Style Selector="c|SegmentDisplay.vfdseg">
      <Setter Property="Foreground" Value="#66D4CF" />
      <Setter Property="Unlit" Value="Transparent" />
      <Setter Property="Effect">
        <DropShadowEffect Color="#66D4CF" BlurRadius="4" OffsetX="0" OffsetY="0" Opacity="0.5" />
      </Setter>
    </Style>
    <Style Selector="c|SegmentDisplay.vfdseg.unlit">
      <Setter Property="Foreground" Value="#163331" />
      <Setter Property="Effect" Value="{x:Null}" />
    </Style>
    <Style Selector="c|VfdText.vfd.off">
      <Setter Property="Foreground" Value="#163331" />
      <Setter Property="Effect" Value="{x:Null}" />
    </Style>
    <!-- Printed legends on the display glass: plain ink, never lit. -->
    <Style Selector="TextBlock.vfdink">
      <Setter Property="Foreground" Value="#8E949C" />
      <Setter Property="FontSize" Value="6.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The other zones, as a real VFD gets from filters over parts of the glass: light yellow for the
         settings, green for PLAY, bluish white for RZX, red for recording. Each has its own unlit tint;
         listed after the cyan default so they win, each unlit style after its lit one. -->
    <Style Selector="c|VfdText.vfd.yellow">
      <Setter Property="Foreground" Value="#E6D88E" />
      <Setter Property="Effect">
        <DropShadowEffect Color="#E6D88E" BlurRadius="4" OffsetX="0" OffsetY="0" Opacity="0.5" />
      </Setter>
    </Style>
    <Style Selector="c|VfdText.vfd.yellow.off">
      <Setter Property="Foreground" Value="#38331C" />
      <Setter Property="Effect" Value="{x:Null}" />
    </Style>
    <Style Selector="c|VfdText.vfd.green">
      <Setter Property="Foreground" Value="#8EDB8A" />
      <Setter Property="Effect">
        <DropShadowEffect Color="#8EDB8A" BlurRadius="4" OffsetX="0" OffsetY="0" Opacity="0.5" />
      </Setter>
    </Style>
    <Style Selector="c|VfdText.vfd.green.off">
      <Setter Property="Foreground" Value="#1A3319" />
      <Setter Property="Effect" Value="{x:Null}" />
    </Style>
    <Style Selector="c|VfdText.vfd.white">
      <Setter Property="Foreground" Value="#CFDDEE" />
      <Setter Property="Effect">
        <DropShadowEffect Color="#CFDDEE" BlurRadius="4" OffsetX="0" OffsetY="0" Opacity="0.5" />
      </Setter>
    </Style>
    <Style Selector="c|VfdText.vfd.white.off">
      <Setter Property="Foreground" Value="#2A3038" />
      <Setter Property="Effect" Value="{x:Null}" />
    </Style>
    <Style Selector="c|VfdText.vfd.red">
      <Setter Property="Foreground" Value="#E0645C" />
      <Setter Property="Effect">
        <DropShadowEffect Color="#E0645C" BlurRadius="4" OffsetX="0" OffsetY="0" Opacity="0.5" />
      </Setter>
    </Style>
    <Style Selector="c|VfdText.vfd.red.off">
      <Setter Property="Foreground" Value="#3A1816" />
      <Setter Property="Effect" Value="{x:Null}" />
    </Style>
    <!-- The silver finish: light brushed plates with dark print, as on silver hi-fi of the late
         seventies. Keys, the display and the drive bays stay black, as they did on those decks. -->
    <Style Selector="c|DeckPanel.silver c|DeckFaceplate">
      <Setter Property="Finish" Value="Silver" />
    </Style>
    <Style Selector="c|DeckPanel.silver TextBlock.legend">
      <Setter Property="Foreground" Value="#2A2C30" />
    </Style>
    <!-- Print inside the black drive bays stays light. -->
    <Style Selector="c|DeckPanel.silver Border.bay TextBlock.legend">
      <Setter Property="Foreground" Value="{StaticResource DeckLegend}" />
    </Style>
    <Style Selector="c|DeckPanel.silver TextBlock.section">
      <Setter Property="Foreground" Value="#45474C" />
    </Style>
    <Style Selector="c|DeckPanel.silver TextBlock.version">
      <Setter Property="Foreground" Value="#45474C" />
    </Style>
    <Style Selector="c|DeckPanel.silver Border.bracket">
      <Setter Property="BorderBrush" Value="#45474C" />
    </Style>
    <Style Selector="c|DeckPanel.silver Border.divider">
      <Setter Property="BorderBrush" Value="#70FFFFFF" />
      <Setter Property="Background" Value="#7C8086" />
    </Style>
    <Style Selector="c|DeckPanel.silver c|DeckKnob">
      <Setter Property="Finish" Value="Silver" />
      <Setter Property="LegendBrush" Value="#2A2C30" />
      <Setter Property="LegendLitBrush" Value="#C2410C" />
      <Setter Property="TickBrush" Value="#45474C" />
    </Style>
    <Style Selector="c|DeckPanel.silver c|DeckSlideSwitch">
      <Setter Property="Finish" Value="Silver" />
      <Setter Property="LegendBrush" Value="#2A2C30" />
      <Setter Property="LegendLitBrush" Value="#C2410C" />
      <Setter Property="TickBrush" Value="#45474C" />
    </Style>
    <Style Selector="c|DeckPanel.silver c|DeckFader">
      <Setter Property="Finish" Value="Silver" />
      <Setter Property="ScaleBrush" Value="#45474C" />
    </Style>
    <!-- Silver keys with dark symbols. Later styles here win over the keys' own themes, so hover,
         press and a latched pause each need saying again. -->
    <Style Selector="c|DeckPanel.silver :is(Button) /template/ Border#PART_Body">
      <Setter Property="Background" Value="{StaticResource SilverKeyFace}" />
      <Setter Property="BorderBrush" Value="#5E6166" />
    </Style>
    <Style Selector="c|DeckPanel.silver :is(Button):pointerover /template/ Border#PART_Body">
      <Setter Property="Background" Value="{StaticResource SilverKeyFaceHover}" />
    </Style>
    <Style Selector="c|DeckPanel.silver :is(Button):pressed /template/ Border#PART_Body">
      <Setter Property="Background" Value="{StaticResource SilverKeyFacePressed}" />
    </Style>
    <Style Selector="c|DeckPanel.silver ToggleButton#PauseKey:checked /template/ Border#PART_Body">
      <Setter Property="Background" Value="{StaticResource SilverKeyFacePressed}" />
    </Style>
    <!-- Bright orange lamp strips, to stand out on the light keys. Only a faint, tight glow: on a
         light key a wide one spreads over the face and washes the lamp out. -->
    <Style Selector="c|DeckPanel.silver ToggleButton /template/ Border#PART_Lamp">
      <Setter Property="Background" Value="#4A2A14" />
    </Style>
    <Style Selector="c|DeckPanel.silver ToggleButton:checked /template/ Border#PART_Lamp">
      <Setter Property="Background" Value="#FF5200" />
      <Setter Property="BoxShadow" Value="0 0 1.5 0 #70D04000" />
    </Style>
    <!-- The keys' shadow on the plate: solid black under a black key, but under a light one it
         shows round the bottom corners, so on silver it is a soft dark instead. Reset sits in a
         ring rather than casting a shadow, and keeps it. -->
    <Style Selector="c|DeckPanel.silver :is(Button):not(#ResetKey) /template/ Panel > Border:nth-child(1)">
      <Setter Property="Background" Value="#38000000" />
    </Style>
    <Style Selector="c|DeckPanel.silver Path.glyph">
      <Setter Property="Fill" Value="#2A2C30" />
    </Style>
    <Style Selector="c|DeckPanel.silver Path.glyphline">
      <Setter Property="Stroke" Value="#2A2C30" />
    </Style>
    <!-- On silver the badge is dark polished metal, catching the light along its lower edge. -->
    <Style Selector="c|DeckPanel.silver Canvas.badge">
      <Setter Property="Effect">
        <DropShadowEffect OffsetX="0" OffsetY="0.8" BlurRadius="0.6" Color="#FFFFFF" Opacity="0.75" />
      </Setter>
    </Style>
    <Style Selector="c|DeckPanel.silver Canvas.badge Path">
      <Setter Property="Stroke">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#5C6066" Offset="0" />
          <GradientStop Color="#2C2E32" Offset="0.45" />
          <GradientStop Color="#17181A" Offset="0.55" />
          <GradientStop Color="#34363A" Offset="1" />
        </LinearGradientBrush>
      </Setter>
    </Style>
  </UserControl.Styles>

  <!-- One deck shows at a time, picked with the DECK selector beside it. Both are always laid out,
       one over the other, so the shelf keeps the taller one's height and choosing the other deck
       does not resize the window; the deck not showing is made transparent and untouchable. -->
  <Grid ColumnDefinitions="Auto,*">

    <Border CornerRadius="5" BoxShadow="0 3 8 0 #B0000000" Margin="0,0,5,0">
      <c:DeckFaceplate Padding="8,10,8,9">
        <!-- The badge, here so it shows whichever deck is up; under it the slim selector keys, each
             lamp lit for the deck showing, with the deck's letter beside it. -->
        <Grid RowDefinitions="Auto,*">
          <StackPanel VerticalAlignment="Top" Margin="0,2,0,0">
            <!-- The name in thin, squared-off lower-case strokes like Sinclair's own lettering, in
                 steel like a hi-fi maker's badge: a sheen across each letter, and a dark edge below
                 where it stands off the plate. Drawn rather than set in a font: five letters need
                 no font file. -->
            <Canvas Classes="badge" Width="54" Height="10" HorizontalAlignment="Left" Margin="1,3,0,0" AutomationProperties.Name="zero x">
              <Path Data="M0.7,0.7 H7.3 L0.7,9.3 H7.3" />
              <Path Data="M17.9,9.3 H13.3 Q11.3,9.3 11.3,7.3 V2.7 Q11.3,0.7 13.3,0.7 H15.9 Q17.9,0.7 17.9,2.7 V4.8 H11.3" />
              <Path Data="M21.9,9.3 V2.7 Q21.9,0.7 23.9,0.7 H27.5" />
              <Path Data="M33.5,0.7 H36.1 Q38.1,0.7 38.1,2.7 V7.3 Q38.1,9.3 36.1,9.3 H33.5 Q31.5,9.3 31.5,7.3 V2.7 Q31.5,0.7 33.5,0.7 Z" />
              <Path Data="M46.6,0.7 L53.2,9.3 M53.2,0.7 L46.6,9.3" />
            </Canvas>
            <!-- A thin rule in the Spectrum's rainbow colours, as long as the name. -->
            <Grid Width="54" Height="1.5" ColumnDefinitions="*,*,*,*" HorizontalAlignment="Left" Margin="1,4,0,0">
              <Border Background="#E8302A" />
              <Border Grid.Column="1" Background="#F7B500" />
              <Border Grid.Column="2" Background="#3BAA45" />
              <Border Grid.Column="3" Background="#1D9AD6" />
            </Grid>
            <TextBlock x:Name="VersionText" Classes="version" FontFamily="fonts:Inter#Inter, $Default" FontSize="8" FontWeight="SemiBold"
                       LetterSpacing="0.8" Margin="1,3,0,0" />
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,5,Auto" RowDefinitions="Auto,Auto,8,Auto" VerticalAlignment="Bottom" Margin="0,0,0,6">
            <TextBlock Grid.ColumnSpan="3" Classes="legend" HorizontalAlignment="Left" Margin="0,0,0,7" Text="DECK" />
            <ToggleButton x:Name="DeckAKey" Grid.Row="1" Theme="{StaticResource DeckToggle}" Width="24" Height="12"
                          ToolTip.Tip="Deck A: the cassette deck" />
            <TextBlock Grid.Row="1" Grid.Column="2" Classes="legend" VerticalAlignment="Center" Text="A" />
            <ToggleButton x:Name="DeckBKey" Grid.Row="3" Theme="{StaticResource DeckToggle}" Width="24" Height="12"
                          ToolTip.Tip="Deck B: the receiver" />
            <TextBlock Grid.Row="3" Grid.Column="2" Classes="legend" VerticalAlignment="Center" Text="B" />
          </Grid>
        </Grid>
      </c:DeckFaceplate>
    </Border>

    <Panel Grid.Column="1">

      <!-- The cassette deck: everything in constant use. Badge and power, the machine selector, the
           display and tape transport, and volume. -->
      <Border x:Name="CassetteDeck" CornerRadius="5" BoxShadow="0 3 8 0 #B0000000">
        <c:DeckFaceplate Padding="16,10,16,9">
          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
            <!-- Power and pause side by side as a split key, centred in the room above reset: power
                 on the left with its light, and a latching pause on the right that stays down while
                 paused. At the bottom, reset in a shallow ring, its name level with the other keys';
                 a quick press is a soft reset, holding it a hard one. -->
            <Grid RowDefinitions="*,Auto,Auto,*,Auto" ColumnDefinitions="50,3,28">
              <Button x:Name="PowerKey" Grid.Row="1" Theme="{StaticResource DeckKey}" Width="50" Height="30"
                      ToolTip.Tip="Power: quit Zero X">
                <Panel Width="46" Height="26">
                  <c:DeckLed x:Name="PowerLed" Width="7" Height="7" Color="#FF3B30"
                             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0" />
                </Panel>
              </Button>
              <ToggleButton x:Name="PauseKey" Grid.Row="1" Grid.Column="2" Theme="{StaticResource DeckLatchKey}" Width="28" Height="30"
                            ToolTip.Tip="Pause the emulator (F7)" />
              <TextBlock Grid.Row="2" Classes="legend" Text="POWER" Margin="0,3,0,0" />
              <TextBlock Grid.Row="2" Grid.Column="2" Classes="legend" Text="PAUSE" Margin="0,3,0,0" />
              <StackPanel Grid.Row="4" Grid.ColumnSpan="3" HorizontalAlignment="Center">
                <Button x:Name="ResetKey" Theme="{StaticResource DeckRecessedKey}" HorizontalAlignment="Center"
                        ToolTip.Tip="Reset the Spectrum (F9). Hold it down for a hard reset (Shift+F9)." />
                <TextBlock Classes="legend" Text="RESET" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>

            <Border Grid.Column="1" Classes="divider" />

            <!-- Detented slide switches, like a tape-type selector, the full width of the column.
                 Changing machine resets it, so they act only when let go, and ignore the wheel. Under
                 the joystick, slim keys for what plays it, bracketed up into it. The column fills the
                 deck's height, which the display and tape keys set: the machine at the top, the keys'
                 names level with the other keys' along the bottom, and the room left over shared
                 between the gap above the joystick and the bracket's stem, the stem taking more. -->
            <Grid Grid.Column="2" RowDefinitions="Auto,3*,Auto,14*,Auto">
              <c:DeckSlideSwitch x:Name="MachineSwitch" Margin="0,4,0,0" Positions="48K,128K,128KE,+3,PENT"
                                 ToolTip.Tip="Machine: slide or click to choose. Switching resets the Spectrum." />
              <c:DeckSlideSwitch x:Name="JoystickSwitch" Grid.Row="2" Margin="0,6,0,0" Positions="KEMP,SINC 1,SINC 2,CURS"
                                 ToolTip.Tip="Joystick: which interface the Spectrum sees" />
              <!-- The bracket: a stem down from the joystick's slot, branching to each key. Six even
                   columns put its branches over the centres of the three keys below. -->
              <Grid Grid.Row="3" ColumnDefinitions="*,*,*,*,*,*" RowDefinitions="*,4" MinHeight="7" Margin="0,1,0,1">
                <Border Grid.Column="3" Classes="bracket" BorderThickness="0.8,0,0,0" />
                <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Classes="bracket" BorderThickness="0.8,0.8,0.8,0" />
                <Border Grid.Row="1" Grid.Column="3" Classes="bracket" BorderThickness="0.8,0,0,0" />
              </Grid>
              <Grid Grid.Row="4" ColumnDefinitions="*,*,*">
                <StackPanel>
                  <ToggleButton x:Name="JoystickCursorKey" Theme="{StaticResource DeckToggle}" Width="24" Height="10"
                                ToolTip.Tip="The cursor keys play the joystick" />
                  <TextBlock Classes="legend" Text="CURSOR" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <ToggleButton x:Name="JoystickGamepadKey" Theme="{StaticResource DeckToggle}" Width="24" Height="10"
                                ToolTip.Tip="Gamepad 1 plays the joystick" />
                  <TextBlock Classes="legend" Text="GAMEPAD" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <ToggleButton x:Name="JoystickNoneKey" Theme="{StaticResource DeckToggle}" Width="24" Height="10"
                                ToolTip.Tip="Nothing plays the joystick" />
                  <TextBlock Classes="legend" Text="NONE" Margin="0,2,0,0" />
                </StackPanel>
              </Grid>
            </Grid>

            <Border Grid.Column="3" Classes="divider" />

            <!-- A fixed width: the decks are measured at their natural size, so without one a long
                 message on the display would widen the deck instead of being trimmed. -->
            <StackPanel Grid.Column="4" Width="240" Spacing="6">
              <Border Height="63" CornerRadius="3" Background="#050B0B" BorderBrush="#000000" BorderThickness="1"
                      BoxShadow="inset 0 1 3 0 #C0000000">
                <Grid Margin="7,3,7,3" RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto">
                  <!-- The machines, as fixed legends with the current one lit. 128K lights for both 128
                       models; its E only for the 128KE. -->
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:VfdText x:Name="Vfd48k" Classes="vfd off" Text="48K" />
                    <StackPanel Orientation="Horizontal">
                      <c:VfdText x:Name="Vfd128k" Classes="vfd off" Text="128K" />
                      <c:VfdText x:Name="Vfd128kE" Classes="vfd off" Text="E" />
                    </StackPanel>
                    <c:VfdText x:Name="VfdPlus3" Classes="vfd off" Text="+3" />
                    <c:VfdText x:Name="VfdPentagon" Classes="vfd off" Text="PENT" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                    <c:VfdText x:Name="VfdStereo" Classes="vfd yellow" Text="ACB" />
                    <c:VfdText x:Name="VfdTurbo" Classes="vfd yellow off" Text="TURBO" />
                    <c:VfdText x:Name="VfdMute" Classes="vfd yellow off" Text="MUTE" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="1">
                    <!-- The transport, as fixed legends: PLAY, STOP and REC, with RZX lit as well when it is
                         a recording that is playing back or being made. -->
                    <Grid ColumnDefinitions="Auto,*">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <c:VfdText x:Name="VfdPlay" Classes="vfd green off" Text="▶ PLAY" />
                        <c:VfdText x:Name="VfdStop" Classes="vfd off" Text="■ STOP" />
                        <c:VfdText x:Name="VfdRec" Classes="vfd red off" Text="● REC" />
                      </StackPanel>
                      <c:VfdText x:Name="VfdRzx" Grid.Column="1" Classes="vfd white off" HorizontalAlignment="Center" Text="RZX" />
                    </Grid>
                    <c:VfdText x:Name="VfdTitle" Classes="vfd" Trim="True" Margin="0,2,0,0" Text="NO TAPE" />
                  </StackPanel>
                  <!-- The tape counter, the display's main readout, with its unlit segments showing through. -->
                  <!-- Two layers of the same digits: every segment unlit underneath, the lit ones and their glow
                       on top. One control doing both would put the glow round the unlit segments too. -->
                  <!-- Raised a little off centre, to leave the block and frame rate below it room. -->
                  <Panel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,6">
                    <c:SegmentDisplay Classes="vfdseg unlit" Digits="3" DigitHeight="19" Text="888" />
                    <c:SegmentDisplay x:Name="VfdCounter" Classes="vfdseg" Digits="3" DigitHeight="19" Text="000" />
                  </Panel>
                  <!-- Disk drives, a line each: a segment that lights while that drive is busy, then the
                       disk in it (its file name). Lit when the drive holds a disk; unlit when it is
                       empty or the machine has no drives. The Pentagon's C and D take a second
                       column; with only A and B, their column spans both. -->
                  <Grid Grid.Row="2" ColumnDefinitions="*,*">
                    <Grid x:Name="VfdDrivesAB" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                      <Border x:Name="VfdLedA" Classes="vfdled" />
                      <c:VfdText x:Name="VfdDiskA" Grid.Column="1" Classes="vfd off" Trim="True" Text="A: --" />
                      <Border x:Name="VfdLedB" Grid.Row="1" Classes="vfdled" />
                      <c:VfdText x:Name="VfdDiskB" Grid.Row="1" Grid.Column="1" Classes="vfd off" Trim="True" Text="B: --" />
                    </Grid>
                    <Grid x:Name="VfdDrivesCD" Grid.Column="1" IsVisible="False" Margin="6,0,0,0" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                      <Border x:Name="VfdLedC" Classes="vfdled" />
                      <c:VfdText x:Name="VfdDiskC" Grid.Column="1" Classes="vfd off" Trim="True" Text="C: --" />
                      <Border x:Name="VfdLedD" Grid.Row="1" Classes="vfdled" />
                      <c:VfdText x:Name="VfdDiskD" Grid.Row="1" Grid.Column="1" Classes="vfd off" Trim="True" Text="D: --" />
                    </Grid>
                  </Grid>
                  <!-- Under the counter: the tape's block, then the frame rate. -->
                  <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <!-- Nudged up off the frame rate, without growing the row under the counter. -->
                    <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right" RenderTransform="translate(0px, -2px)">
                      <TextBlock Classes="vfdink" Text="BLK" />
                      <c:VfdText x:Name="VfdBlock" Classes="vfd" Text="--/--" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                      <c:VfdText x:Name="VfdFps" Classes="vfd" Text="" />
                      <TextBlock x:Name="VfdFpsLabel" Classes="vfdink" IsVisible="False" Text="FPS" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>

              <Grid ColumnDefinitions="*,*,*,*,*,*,*" RowDefinitions="Auto,Auto">
                <Button x:Name="EjectKey" Grid.Column="0" Theme="{StaticResource DeckKey}" ToolTip.Tip="Eject the tape, or insert one when the deck is empty">
                  <Path Classes="glyph" Data="M0,5 L4.5,0 L9,5 Z M0,6.5 H9 V8 H0 Z" />
                </Button>
                <Button x:Name="RecKey" Grid.Column="1" Theme="{StaticResource DeckKey}" ToolTip.Tip="Record: choose the tape file SAVE writes to. Press again to go back to the default.">
                  <c:DeckLed x:Name="RecLamp" Width="9" Height="9" Color="#FF3B30" />
                </Button>
                <Button x:Name="RewindKey" Grid.Column="2" Theme="{StaticResource DeckKey}" ToolTip.Tip="Rewind to the start of the tape">
                  <Path Classes="glyph" Data="M0,3.5 L4.5,0 V7 Z M4.5,3.5 L9,0 V7 Z" />
                </Button>
                <Button x:Name="PrevKey" Grid.Column="3" Theme="{StaticResource DeckKey}" ToolTip.Tip="Previous block">
                  <Path Classes="glyph" Data="M0,0 H1.5 V7 H0 Z M1.5,3.5 L6.5,0 V7 Z" />
                </Button>
                <Button x:Name="PlayKey" Grid.Column="4" Theme="{StaticResource DeckKey}" ToolTip.Tip="Play">
                  <Path Classes="glyph" Data="M0,0 L7,4 L0,8 Z" />
                </Button>
                <Button x:Name="NextKey" Grid.Column="5" Theme="{StaticResource DeckKey}" ToolTip.Tip="Next block">
                  <Path Classes="glyph" Data="M0,0 L5,3.5 L0,7 Z M5,0 H6.5 V7 H5 Z" />
                </Button>
                <Button x:Name="StopKey" Grid.Column="6" Theme="{StaticResource DeckKey}" ToolTip.Tip="Stop">
                  <Path Classes="glyph" Data="M0,0 H7 V7 H0 Z" />
                </Button>
                <TextBlock Grid.Row="1" Grid.Column="0" Classes="legend" Text="EJECT" Margin="0,4,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="legend" Text="REC" Margin="0,4,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="2" Classes="legend" Text="REW" Margin="0,4,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="3" Classes="legend" Text="PREV" Margin="0,4,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="4" Classes="legend" Text="PLAY" Margin="0,4,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="5" Classes="legend" Text="NEXT" Margin="0,4,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="6" Classes="legend" Text="STOP" Margin="0,4,0,0" />
              </Grid>
            </StackPanel>


            <Border Grid.Column="5" Classes="divider" />

            <StackPanel Grid.Column="6" VerticalAlignment="Center">
              <c:DeckKnob x:Name="VolumeKnob" Width="66" Height="66" Minimum="0" Maximum="100" SmallChange="5"
                          Ends="MIN,MAX" ToolTip.Tip="Volume" />
              <TextBlock Classes="legend" Text="VOLUME" Margin="0,1,0,0" />
            </StackPanel>
          </Grid>
        </c:DeckFaceplate>
      </Border>

      <!-- The receiver: picture, sound and speed settings, and the disk drives. The sections share
           the deck's width evenly. -->
      <Border x:Name="ReceiverDeck" CornerRadius="5" BoxShadow="0 3 8 0 #B0000000">
        <c:DeckFaceplate Padding="16,10,16,9">
          <Grid ColumnDefinitions="*,Auto,*,Auto,Auto,Auto,*,Auto,*" VerticalAlignment="Center">

            <!-- Picture. -->
            <StackPanel Grid.Column="0" Width="112" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Grid ColumnDefinitions="*,6,*" RowDefinitions="Auto,Auto" Margin="0,0,0,8">
                <ToggleButton x:Name="CrtKey" Theme="{StaticResource DeckToggle}" Width="50" Height="14" ToolTip.Tip="CRT effects" />
                <ToggleButton x:Name="ScanKey" Grid.Column="2" Theme="{StaticResource DeckToggle}" Width="50" Height="14" ToolTip.Tip="Scanlines" />
                <TextBlock Grid.Row="1" Classes="legend" Text="CRT" Margin="0,3,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="2" Classes="legend" Text="SCAN" Margin="0,3,0,0" />
              </Grid>
              <Grid ColumnDefinitions="34,*" RowDefinitions="18,6,18">
                <TextBlock Classes="legend" Text="CURVE" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <c:DeckFader x:Name="CurveFader" Grid.Column="1" />
                <TextBlock Grid.Row="2" Classes="legend" Text="HOUSING" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <c:DeckFader x:Name="HousingFader" Grid.Row="2" Grid.Column="1" />
              </Grid>
            </StackPanel>

            <Border Grid.Column="1" Classes="divider" />

            <!-- Sound: stereo mode and mute. -->
            <StackPanel Grid.Column="2" Width="64" HorizontalAlignment="Center" VerticalAlignment="Center">
              <c:DeckKnob x:Name="StereoKnob" Width="64" Height="50" Positions="MONO,ACB,ABC" ToolTip.Tip="Stereo mode" />
              <TextBlock Classes="legend" Text="STEREO" Margin="0,-9,0,10" />
              <ToggleButton x:Name="MuteKey" Theme="{StaticResource DeckToggle}" Width="50" Height="14" HorizontalAlignment="Center"
                            ToolTip.Tip="Mute" />
              <TextBlock Classes="legend" Text="MUTE" Margin="0,3,0,0" />
            </StackPanel>

            <Border Grid.Column="3" Width="18" />

            <!-- Speed: CPU and full speed. -->
            <StackPanel Grid.Column="4" Width="64" HorizontalAlignment="Center" VerticalAlignment="Center">
              <c:DeckKnob x:Name="CpuKnob" Width="64" Height="50" Positions="1X,2X,4X" ToolTip.Tip="CPU speed" />
              <TextBlock Classes="legend" Text="CPU" Margin="0,-9,0,10" />
              <ToggleButton x:Name="TurboKey" Theme="{StaticResource DeckToggle}" Width="50" Height="14" HorizontalAlignment="Center"
                            ToolTip.Tip="Full speed" />
              <TextBlock Classes="legend" Text="TURBO" Margin="0,3,0,0" />
            </StackPanel>

            <Border Grid.Column="5" Classes="divider" />

            <!-- The drives, after the machines' own: a slot, a busy light and an eject button each. The
                 +3's A over B; the Pentagon's four two by two, A and B on the left and C and D in the
                 room to their right, so the deck gets no taller. -->
            <Grid x:Name="DriveBays" Grid.Column="6" Width="150" ColumnDefinitions="*,6,*" RowDefinitions="Auto,8,Auto"
                  HorizontalAlignment="Center" VerticalAlignment="Top">
              <!-- The bay: the drive letter over its busy light, the slot with the disk's name under it, and the eject button. -->
              <Border x:Name="DriveABay" Classes="bay" Grid.ColumnSpan="3" Grid.Row="0" Grid.Column="0" Height="36" CornerRadius="3" Background="#141517"
                      BorderBrush="#050506" BorderThickness="1" BoxShadow="inset 0 1 2 0 #A0000000">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="7,0,5,0">
                  <StackPanel Margin="0,0,7,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="legend" Text="A" />
                    <c:DeckLed x:Name="DriveALed" Width="7" Height="7" Color="#FF3B30" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <Border Height="8" CornerRadius="2" Background="#020202" BorderBrush="#2E3034" BorderThickness="0,0,0,1">
                      <!-- A disk in the slot: its case, with the label edge showing. -->
                      <Border x:Name="DriveADisk" IsVisible="False" Margin="2,1,2,1" CornerRadius="1" Background="#34363B">
                        <Border Width="34" HorizontalAlignment="Left" Margin="6,1,0,1" CornerRadius="1" Background="#D9D3BC" />
                      </Border>
                    </Border>
                    <TextBlock x:Name="DriveAName" Classes="bayname" Text="NO DISK" />
                  </StackPanel>
                  <Button x:Name="DriveAEject" Grid.Column="2" Theme="{StaticResource DeckKey}" Width="22" Height="16"
                          Margin="7,0,0,0" ToolTip.Tip="Eject the disk from drive A, or insert one when it is empty">
                    <Path Classes="glyph" Data="M0,4 L3.5,0 L7,4 Z M0,5.2 H7 V6.4 H0 Z" />
                  </Button>
                </Grid>
              </Border>
              <!-- The bay: the drive letter over its busy light, the slot with the disk's name under it, and the eject button. -->
              <Border x:Name="DriveBBay" Classes="bay" Grid.ColumnSpan="3" Grid.Row="2" Grid.Column="0" Height="36" CornerRadius="3" Background="#141517"
                      BorderBrush="#050506" BorderThickness="1" BoxShadow="inset 0 1 2 0 #A0000000">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="7,0,5,0">
                  <StackPanel Margin="0,0,7,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="legend" Text="B" />
                    <c:DeckLed x:Name="DriveBLed" Width="7" Height="7" Color="#FF3B30" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <Border Height="8" CornerRadius="2" Background="#020202" BorderBrush="#2E3034" BorderThickness="0,0,0,1">
                      <!-- A disk in the slot: its case, with the label edge showing. -->
                      <Border x:Name="DriveBDisk" IsVisible="False" Margin="2,1,2,1" CornerRadius="1" Background="#34363B">
                        <Border Width="34" HorizontalAlignment="Left" Margin="6,1,0,1" CornerRadius="1" Background="#D9D3BC" />
                      </Border>
                    </Border>
                    <TextBlock x:Name="DriveBName" Classes="bayname" Text="NO DISK" />
                  </StackPanel>
                  <Button x:Name="DriveBEject" Grid.Column="2" Theme="{StaticResource DeckKey}" Width="22" Height="16"
                          Margin="7,0,0,0" ToolTip.Tip="Eject the disk from drive B, or insert one when it is empty">
                    <Path Classes="glyph" Data="M0,4 L3.5,0 L7,4 Z M0,5.2 H7 V6.4 H0 Z" />
                  </Button>
                </Grid>
              </Border>
              <!-- The bay: the drive letter over its busy light, the slot with the disk's name under it, and the eject button. -->
              <Border x:Name="DriveCBay" Classes="bay" IsVisible="False" Grid.Row="0" Grid.Column="2" Height="36" CornerRadius="3" Background="#141517"
                      BorderBrush="#050506" BorderThickness="1" BoxShadow="inset 0 1 2 0 #A0000000">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="7,0,5,0">
                  <StackPanel Margin="0,0,7,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="legend" Text="C" />
                    <c:DeckLed x:Name="DriveCLed" Width="7" Height="7" Color="#FF3B30" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <Border Height="8" CornerRadius="2" Background="#020202" BorderBrush="#2E3034" BorderThickness="0,0,0,1">
                      <!-- A disk in the slot: its case, with the label edge showing. -->
                      <Border x:Name="DriveCDisk" IsVisible="False" Margin="2,1,2,1" CornerRadius="1" Background="#34363B">
                        <Border Width="34" HorizontalAlignment="Left" Margin="6,1,0,1" CornerRadius="1" Background="#D9D3BC" />
                      </Border>
                    </Border>
                    <TextBlock x:Name="DriveCName" Classes="bayname" Text="NO DISK" />
                  </StackPanel>
                  <Button x:Name="DriveCEject" Grid.Column="2" Theme="{StaticResource DeckKey}" Width="22" Height="16"
                          Margin="7,0,0,0" ToolTip.Tip="Eject the disk from drive C, or insert one when it is empty">
                    <Path Classes="glyph" Data="M0,4 L3.5,0 L7,4 Z M0,5.2 H7 V6.4 H0 Z" />
                  </Button>
                </Grid>
              </Border>
              <!-- The bay: the drive letter over its busy light, the slot with the disk's name under it, and the eject button. -->
              <Border x:Name="DriveDBay" Classes="bay" IsVisible="False" Grid.Row="2" Grid.Column="2" Height="36" CornerRadius="3" Background="#141517"
                      BorderBrush="#050506" BorderThickness="1" BoxShadow="inset 0 1 2 0 #A0000000">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="7,0,5,0">
                  <StackPanel Margin="0,0,7,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="legend" Text="D" />
                    <c:DeckLed x:Name="DriveDLed" Width="7" Height="7" Color="#FF3B30" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <Border Height="8" CornerRadius="2" Background="#020202" BorderBrush="#2E3034" BorderThickness="0,0,0,1">
                      <!-- A disk in the slot: its case, with the label edge showing. -->
                      <Border x:Name="DriveDDisk" IsVisible="False" Margin="2,1,2,1" CornerRadius="1" Background="#34363B">
                        <Border Width="34" HorizontalAlignment="Left" Margin="6,1,0,1" CornerRadius="1" Background="#D9D3BC" />
                      </Border>
                    </Border>
                    <TextBlock x:Name="DriveDName" Classes="bayname" Text="NO DISK" />
                  </StackPanel>
                  <Button x:Name="DriveDEject" Grid.Column="2" Theme="{StaticResource DeckKey}" Width="22" Height="16"
                          Margin="7,0,0,0" ToolTip.Tip="Eject the disk from drive D, or insert one when it is empty">
                    <Path Classes="glyph" Data="M0,4 L3.5,0 L7,4 Z M0,5.2 H7 V6.4 H0 Z" />
                  </Button>
                </Grid>
              </Border>
            </Grid>

          </Grid>
        </c:DeckFaceplate>
      </Border>

    </Panel>
  </Grid>
</UserControl>
